# Smart Cart Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# -----------------------------------------------------------------------
# MQTT Mode
# mock = no broker required, logs payload to console (DEFAULT for dev)
# real = connects to real MQTT broker using credentials below
# -----------------------------------------------------------------------
MQTT_MODE=mock

# -----------------------------------------------------------------------
# Default Smart Cart ID
# This will be used as the MQTT topic target until dynamic cart assignment
# is implemented. Topic: smartcart/orders/{DEFAULT_CART_ID}
# -----------------------------------------------------------------------
DEFAULT_CART_ID=cart-01

# -----------------------------------------------------------------------
# MQTT Broker Configuration (only needed when MQTT_MODE=real)
# -----------------------------------------------------------------------
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smartcart-backend
MQTT_TLS_ENABLED=false

# -----------------------------------------------------------------------
# MQTT Topic & QoS
# QoS 1 = at least once delivery (recommended for order commands)
# -----------------------------------------------------------------------
MQTT_TOPIC_PREFIX=smartcart
MQTT_QOS=1
MQTT_MAX_RETRIES=3

# -----------------------------------------------------------------------
# Security
# Change JWT_SECRET_KEY in production!
# -----------------------------------------------------------------------
JWT_SECRET_KEY=super-secret-key-change-in-production

# -----------------------------------------------------------------------
# Google OAuth / OIDC
# GOOGLE_REDIRECT_URI must exactly match the redirect URI configured in
# Google Cloud Console and the frontend EXPO_PUBLIC_GOOGLE_REDIRECT_URI.
# AUTHORIZED_ADMIN_EMAILS is a comma-separated allowlist.
# -----------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/google-callback
AUTHORIZED_ADMIN_EMAILS=smartcart.admin@gmail.com
