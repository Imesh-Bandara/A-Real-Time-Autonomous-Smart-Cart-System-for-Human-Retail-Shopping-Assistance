# CartMate Autonomous Smart Cart Backend — Environment Variables
# Copy this file to .env and configure your values.

# -----------------------------------------------------------------------
# Database Configuration (PostgreSQL via SQLAlchemy / psycopg2)
# -----------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cartmate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cartmate

# If PostgreSQL is offline during initial local setup, backend automatically
# falls back to local SQLite (sqlite:///cartmate.db) so you can test immediately.
DATABASE_FALLBACK_URL=sqlite:///cartmate.db

# -----------------------------------------------------------------------
# MQTT Broker Configuration (using paho-mqtt)
# -----------------------------------------------------------------------
# mock = logs navigation payload to console (default for local dev)
# real = connects to real MQTT broker at MQTT_BROKER_HOST:MQTT_BROKER_PORT
MQTT_MODE=mock
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=cartmate-backend
MQTT_TLS_ENABLED=false
MQTT_QOS=1
MQTT_MAX_RETRIES=3

# Target topic for autonomous shopping cart navigation waypoints
MQTT_TARGET_TOPIC=cartmate/navigation/target
DEFAULT_CART_ID=CART_01

# -----------------------------------------------------------------------
# Security & Port
# -----------------------------------------------------------------------
PORT=5000
JWT_SECRET_KEY=super-secret-key-change-in-production
